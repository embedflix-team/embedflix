# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real keys.

# Required: every specialist, the supervisor, judge, and code_writer call
# anthropic.Anthropic() directly and need this to do anything.
ANTHROPIC_API_KEY=

# Optional: only loss_function_changer.py's headers reference this
# (anthropic-workspace-id) -- fine to leave blank if you don't use workspaces.
ANTHROPIC_WORKSPACE_ID=

# Optional: powers the web_search MCP tool. Without it, web_search degrades
# gracefully (returns "Search failed: ... Proceed with your existing
# knowledge." instead of crashing) -- specialists just won't get real
# concept/code research.
TAVILY_API_KEY=
